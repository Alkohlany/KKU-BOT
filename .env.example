# Telegram Bot Configuration
BOT_TOKEN=your_bot_token_here

# Database Configuration
# Railway provides DATABASE_URL automatically when you add a PostgreSQL service
# Format: postgresql+asyncpg://user:password@host:5432/database_name
# NOTE: Railway uses postgres:// — the app auto-converts to postgresql+asyncpg://
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/kku_bot

# Admin Configuration
ADMIN_IDS=123456789,987654321

# API/Dashboard Configuration
SECRET_KEY=your_secret_key_here
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_secure_password_here

# Cloudflare R2 (optional, for file uploads)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=kku-bot
R2_PUBLIC_URL=
